# Ignore node_modules (will be installed by npm ci in Docker)
node_modules

# Ignore build output (will be created during Docker build)
dist
build

# Ignore development files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode
.idea
*.swp
*.swo

# Ignore test coverage
coverage
