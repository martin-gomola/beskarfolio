# Copy to `.env` (keep `.env` out of git). Only include secrets locally or in CI vars.

# =============================================================================
# SECURITY (Required for public deployments!)
# =============================================================================

# API Key for external requests (curl, scripts)
# Browser requests from allowed CORS origins don't need the key
# Generate with: openssl rand -hex 32
BESKARFOLIO_API_KEY=

# CORS: comma-separated origins (browsers that can access the API)
# Include all domains/IPs where you access the app from
CORS_ORIGINS=https://your-domain.com,http://your-domain.com,http://192.168.x.x:8080,http://localhost:3000,http://localhost:8080

# Trusted hosts: requests from these hosts bypass API key check
# Include your domain and any internal IPs
TRUSTED_HOSTS=your-domain.com,192.168.x.x,localhost,127.0.0.1

# =============================================================================
# GENERAL
# =============================================================================

# Match the container's runtime user to the host owner of backend/data so
# in-container writes (UI "Update Prices") don't fail with EACCES while the
# cron job (running as the host user) silently keeps working. Verify with:
#   stat -c '%u:%g' backend/data/
# Most home setups are 1000:1000.
PUID=1000
PGID=1000

# Logging level
LOG_LEVEL=INFO

# Historical fetch toggle (set false on public deployments to avoid abuse)
AUTO_FETCH_HISTORICAL=true

# =============================================================================
# PRICE PROVIDERS
# =============================================================================

# Price provider selection:
# - auto (default): FMP if FMP_API_KEY set, else Yahoo
# - fmp | finnhub | yahoo: force provider
PRICE_PROVIDER=auto

# API keys (keep blank in git)
FMP_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# Optional overrides
# FMP_BASE_URL=https://financialmodelingprep.com/stable
# PRICE_FETCH_DELAY_MIN=0.5
# PRICE_FETCH_DELAY_MAX=1.5

# =============================================================================
# FRONTEND (injected at container startup)
# =============================================================================

# Analytics script tag injected into index.html at runtime (optional)
# Example: <script defer src="https://analytics.example.com/script.js" data-website-id="..."></script>
# ANALYTICS_SCRIPT=
